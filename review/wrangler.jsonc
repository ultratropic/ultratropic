{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "review",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // How your own selects are labelled for reviewers and in exports. Rename per
  // project from the sidebar; this is the default for new projects.
  "vars": { "ADMIN_NAME": "Ultratropic" },
  "routes": [
    { "pattern": "review.ultra-tropic.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "review-db",
      "database_id": "df9c3ed4-5151-4eaa-a717-921e4491b078",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "review-images" }
  ]
}
