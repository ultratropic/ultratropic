{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "review",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Paths the Worker answers before the asset store. Anything not listed is
    // served as a static file or the SPA and never reaches the Worker, so every
    // Worker route must be here: the API, photos, and the public site's pages.
    "run_worker_first": ["/api/*", "/i/*", "/", "/pricing", "/terms", "/privacy", "/refunds"]
  },
  "observability": { "enabled": true },
  // How your own selects are labelled for reviewers and in exports. Rename per
  // project from the sidebar; this is the default for new projects.
  // MODE "internal": this studio's own deployment (admin password, one workspace,
  // no billing). The public product runs the same code with MODE "public",
  // under its own Worker, database and bucket (an env added here when it has a domain).
  "vars": { "ADMIN_NAME": "Ultratropic", "MODE": "internal" },
  "routes": [
    { "pattern": "review.ultra-tropic.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "review-db",
      "database_id": "df9c3ed4-5151-4eaa-a717-921e4491b078",
      "migrations_dir": "migrations"
    }
  ],
  // Brute-force brakes: per visitor IP, per minute.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UNLOCK_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "review-images" }
  ],

  // The public product (temporary name Dumbox) runs this same code in its own
  // Worker, database and bucket, so customers' data never shares storage with
  // the internal deployment's. Staging: invite-only (SIGNUP_ALLOWLIST secret).
  // Deploy: npm run deploy:staging. Bindings don't inherit, so each is restated.
  "env": {
    "staging": {
      "name": "dumbox-staging",
      "vars": {
        "ADMIN_NAME": "Dumbox",
        "MODE": "public",
        "PRODUCT_NAME": "Dumbox",
        "MAIL_FROM": "dumbox@ultra-tropic.com"
      },
      "routes": [
        { "pattern": "dumbox-staging.ultra-tropic.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dumbox-staging-db",
          "database_id": "ab0087f9-75ec-424c-965f-2e4e2072f5b7",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "dumbox-staging-images" }
      ],
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "UNLOCK_LIMIT", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    },
    // The live public product. Invite-only (SIGNUP_ALLOWLIST) until launch.
    // Deploy: npm run deploy:public.
    "public": {
      "name": "dumbox",
      "vars": {
        "ADMIN_NAME": "Dumbox",
        "MODE": "public",
        "PRODUCT_NAME": "Dumbox",
        "MAIL_FROM": "dumbox@ultra-tropic.com"
      },
      "routes": [
        { "pattern": "dumbox.ultra-tropic.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dumbox-db",
          "database_id": "86b8aa46-6e21-4abd-a71a-642a79796f9c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "dumbox-images" }
      ],
      "ratelimits": [
        { "name": "LOGIN_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "UNLOCK_LIMIT", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
